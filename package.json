{
  "name": "value-bet-finder",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "db:push": "supabase db push --yes --remote"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "axios": "^1.21.0",
    "dotenv": "^16.4.1",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "node-cron": "^4.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.3.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.2.2",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "15.5.29",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.32",
    "supabase": "^3.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}

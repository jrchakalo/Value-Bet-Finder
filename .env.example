# ============================================================
# Value Bet Finder — variáveis de ambiente
# Copie este arquivo para `.env` e preencha com seus valores.
# NUNCA commite o arquivo `.env` no controle de versão.
# ============================================================

# ------------------------------------------------------------
# Supabase (somente server-side)
# ------------------------------------------------------------
# URL pública do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Chave anon (pública por design). Mantenha RLS habilitado no banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Chave service_role: NUNCA exponha no client, em logs ou no repositório.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# Odds-API.io
# ------------------------------------------------------------
ODDS_API_KEY=your-odds-api-key

# ------------------------------------------------------------
# NextAuth / Auth.js
# ------------------------------------------------------------
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Local: http://localhost:3000 | Produção: https://valuebetfinder.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------
# Credenciais do administrador (acesso single-user)
# ------------------------------------------------------------
ADMIN_USERNAME=your-admin-username-here
ADMIN_PASSWORD=your-secure-password-here

# ------------------------------------------------------------
# Conta de demonstração pública (somente leitura)
# ------------------------------------------------------------
# Habilitada por padrão. Use DEMO_ENABLED=false para desativar.
# Se DEMO_USERNAME/DEMO_PASSWORD não forem definidos, os valores
# padrão documentados no README (demo / demo-value-bets) são usados.
DEMO_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo-value-bets

# ------------------------------------------------------------
# Cron / Endpoint de atualização
# ------------------------------------------------------------
# Gere com: openssl rand -base64 32
# Usado no header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate-with-openssl-rand-base64-32

# ------------------------------------------------------------
# Opcional: Supabase CLI (para rodar migrations localmente)
# ------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_DB_PASSWORD=your-database-password
